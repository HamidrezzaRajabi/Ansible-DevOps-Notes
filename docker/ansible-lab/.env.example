# ═══════════════════════════════════════════════════════
#  Ansible Lab – Environment Variables
#  Copy this file to .env and adjust to your needs.
#  cp .env.example .env
# ═══════════════════════════════════════════════════════

# ── SSH port mappings (host:container) ──────────────────
# Each container exposes port 22 internally;
# these map unique host ports to each one.
CONTROL_SSH_PORT=2200
UBUNTU1_SSH_PORT=2201
UBUNTU2_SSH_PORT=2202
ROCKY1_SSH_PORT=2203
ROCKY2_SSH_PORT=2204

# ── Optional DinD Docker API port ───────────────────────
DIND_PORT=2375

# ── Internal lab network subnet ─────────────────────────
LAB_SUBNET=172.20.0.0/24
